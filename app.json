{
  "expo": {
    "name": "MusawoMobile",
    "slug": "MusawoMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "sdkVersion": "54.0.0",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D4F4F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ug.musawo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7a993a01-34d3-4b62-8bd6-0164367ec1e9"
      }
    }
  }
}
